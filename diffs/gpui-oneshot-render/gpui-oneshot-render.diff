+const MAX_FRAME_TIME_MS: u32 = 10000;
+
+#[repr(C)]
+#[derive(Clone, Copy, Pod, Zeroable)]
+struct GlobalParams {
+    viewport_size: [f32; 2],
+    premultiplied_alpha: u32,
+    pad: u32,
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+#[repr(C)]
