+impl PlatformWindow for WaylandWindow {
+    fn render_scene_to_texture(
+        &self,
+        scene: &Scene,
+        size: Size<DevicePixels>,
+    ) -> Result<TextureId> {
+        let mut state = self.0.borrow_mut();
