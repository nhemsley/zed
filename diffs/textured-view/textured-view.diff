+pub struct TexturedSurfaceDisplay {
+    bounds: Bounds<Pixels>,
+    uuid: Uuid,
+}
+
+impl TexturedSurfaceDisplay {
+    pub fn new() -> Self {
+        Self::with_size(Size {
+            width: px(1920.0),
+            height: px(1080.0),
+        })
+    }
+
+    pub fn with_size(size: Size<Pixels>) -> Self {
+        Self {
+            bounds: Bounds {
+                origin: Default::default(),
+                size,
+            },
+            uuid: Uuid::from_bytes([0; 16]),
+        }
+    }
+}
