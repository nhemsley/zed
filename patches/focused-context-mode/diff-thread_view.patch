+    fn toggle_focused_context_mode(&mut self, cx: &mut Context<Self>) {
+        if let Some(thread) = self.thread() {
+            thread.update(cx, |thread, cx| {
+                let current = thread.focused_context_mode();
+                thread.set_focused_context_mode(!current, cx);
+            });
+        }
+    }
