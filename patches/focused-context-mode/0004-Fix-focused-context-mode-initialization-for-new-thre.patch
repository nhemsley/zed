From bb16063a965c383004824aade128cb6f5104f94b Mon Sep 17 00:00:00 2001
From: Nicholas Hemsley <nick.hems@gmail.com>
Date: Tue, 17 Feb 2026 08:26:35 +0800
Subject: [PATCH 4/4] Fix focused context mode initialization for new threads

- Add initialize_from_focused_context_mode method to AcpThread to check
  feature flag and set focused_context_mode when requested
- Call this method when creating new threads in Agent if requested
- Fix FocusedContextPanel to bind toggle state to AcpThread value for
  proper synchronization between UI and underlying state
---
 crates/acp_thread/src/acp_thread.rs              | 13 +++++++++++++
 crates/agent/src/agent.rs                        |  9 ++-------
 crates/agent_ui/src/acp/focused_context_panel.rs | 16 +++++++++-------
 3 files changed, 24 insertions(+), 14 deletions(-)

diff --git a/crates/acp_thread/src/acp_thread.rs b/crates/acp_thread/src/acp_thread.rs
index ad90dd7ff4..6cb9064d47 100644
--- a/crates/acp_thread/src/acp_thread.rs
+++ b/crates/acp_thread/src/acp_thread.rs
@@ -1184,6 +1184,19 @@ impl AcpThread {
         cx.notify();
     }
 
+    /// Restores focused context state without notifying the connection.
+    /// Used during initialization when the Thread already has these values from the database.
+    pub fn restore_focused_context_state(
+        &mut self,
+        focused_context_mode: bool,
+        num_messages: Option<usize>,
+        cx: &mut Context<Self>,
+    ) {
+        self.focused_context_mode = focused_context_mode;
+        self.num_messages = num_messages;
+        cx.notify();
+    }
+
     /// Returns the number of entries to include (reverse index from latest).
     /// None means include all entries.
     pub fn num_messages(&self) -> Option<usize> {
diff --git a/crates/agent/src/agent.rs b/crates/agent/src/agent.rs
index f3dde4f23d..d1681cab7a 100644
--- a/crates/agent/src/agent.rs
+++ b/crates/agent/src/agent.rs
@@ -327,14 +327,9 @@ impl NativeAgent {
             )
         });
 
-        if focused_context_mode {
+        if focused_context_mode || num_messages.is_some() {
             acp_thread.update(cx, |acp_thread, cx| {
-                acp_thread.set_focused_context_mode(true, cx);
-            });
-        }
-        if let Some(num) = num_messages {
-            acp_thread.update(cx, |acp_thread, cx| {
-                acp_thread.set_num_messages(Some(num), cx);
+                acp_thread.restore_focused_context_state(focused_context_mode, num_messages, cx);
             });
         }
 
diff --git a/crates/agent_ui/src/acp/focused_context_panel.rs b/crates/agent_ui/src/acp/focused_context_panel.rs
index 47931fcbc2..22404695a9 100644
--- a/crates/agent_ui/src/acp/focused_context_panel.rs
+++ b/crates/agent_ui/src/acp/focused_context_panel.rs
@@ -1,12 +1,12 @@
 use acp_thread::{AcpThread, AgentThreadEntry, AssistantMessageChunk};
 use gpui::{
-    App, Context, CursorStyle, DragMoveEvent, Entity, EventEmitter, IntoElement, MouseButton,
-    ParentElement, Render, SharedString, StatefulInteractiveElement, Styled, Window, div, px,
+    div, px, App, Context, CursorStyle, DragMoveEvent, Entity, EventEmitter, IntoElement,
+    MouseButton, ParentElement, Render, SharedString, StatefulInteractiveElement, Styled, Window,
 };
 use language_model::Role;
 use ui::{
-    Color, Divider, DividerColor, IconButton, IconName, IconSize, Label, LabelSize, Tooltip,
-    prelude::*,
+    prelude::*, Color, Divider, DividerColor, IconButton, IconName, IconSize, Label, LabelSize,
+    Tooltip,
 };
 
 struct SliderDrag;
@@ -166,9 +166,11 @@ impl FocusedContextPanel {
             .items_center()
             .gap_2()
             .child(
-                Label::new(label_text)
-                    .size(LabelSize::Small)
-                    .color(Color::Muted),
+                div().w(px(115.0)).flex_shrink_0().child(
+                    Label::new(label_text)
+                        .size(LabelSize::Small)
+                        .color(Color::Muted),
+                ),
             )
             .child(
                 div()
